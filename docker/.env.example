# Template for docker/.env  — COPY to docker/.env and fill in.
# docker/.env is gitignored. The REAL values live SOPS-encrypted in
# instance/secrets/dashboards.sops.yml + semaphore.sops.yml; a deploy step
# decrypts them into docker/.env. Never commit real secrets here.

# --- Instance (rendered by deploy-stack from instance/instance.yml mgmt_ip/domain) ---
# KONTROLL_MGMT_IP is the host the GUI, the API and the metrics and log services bind — they listen on the
# management interface only. Homepage and Semaphore are published on all interfaces, to sit behind your reverse
# proxy (SECURITY.md C3).
# The compose binds use ${KONTROLL_MGMT_IP:?...} so an UNSET value fails `compose config` loudly
# rather than silently binding all interfaces. The example value is loopback (safe for a bare
# `compose config`); deploy-stack overwrites it with your real mgmt IP.
KONTROLL_MGMT_IP=127.0.0.1
KONTROLL_DOMAIN=example.com

# --- Semaphore ---
SEMAPHORE_DB_PASSWORD=changeme-db
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=changeme-admin
SEMAPHORE_ADMIN_EMAIL=admin@example.com
# 32 random bytes, base64. Generate: head -c32 /dev/urandom | base64
SEMAPHORE_ACCESS_KEY_ENCRYPTION=changeme-base64-32-bytes

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=changeme-grafana

# --- Logging (Loki + Vector internal stack) — non-secret operator tunables (no SOPS domain at baseline) ---
# Loki GLOBAL retention window (Go duration). 30d default; per-stream overrides live in loki/loki-config.yml.
# ALWAYS set (loki.yaml also defaults it to 720h) so loki-config.yml's ${LOKI_RETENTION_PERIOD} is never empty
# (empty = INFINITE retention = unbounded disk).
LOKI_RETENTION_PERIOD=720h
# Operator home whose ~/.local/state/kontroll/runs Vector tails for the script run-logs (instance-specific).
KONTROLL_OPERATOR_HOME=/home/admin

# --- Metrics retention (Prometheus TSDB) — non-secret operator tunables, FAIL-CLOSED ---
# Prometheus deletes a block when it violates EITHER the age window OR the disk-size cap (whichever trips first).
# Both are ALWAYS set (prometheus.yaml defaults them via ${VAR:-default}) so an empty value can NEVER mean
# "unbounded" — empty PROM_RETENTION_SIZE would be no disk cap = a runaway scrape can fill the disk (the one real
# metrics fail-open hole this closes). Units for size: B/KB/MB/GB/TB or KiB/MiB/GiB/TiB.
PROM_RETENTION_TIME=90d                # TSDB age window (was hardcoded 90d; empty/0 = no time-based deletion)
PROM_RETENTION_SIZE=20GB               # TSDB disk HARD CAP — the backstop vs a runaway scrape (empty = unbounded)

# --- Audit-log rotation (API + onboard-GUI) — FAIL-CLOSED (empty/garbage clamps to the default in code; the
# rotation size/count can never become 0 = no rotation = an unbounded C12 audit file). Defaults == prior hardcode.
KONTROLL_AUDIT_MAX_MB=5                 # per-surface audit rotation size, MB (api/audit.py + gui/app.py)
KONTROLL_AUDIT_MAX_FILES=5             # per-surface audit rotation backup count

# --- Machine-made commit attribution (API + onboard-GUI propose paths) ---
# The ONE trailer line appended to every commit the control plane makes on an operator's behalf
# (scripts/kontroll/gitio.py commit_message_args). Empty = the default `Co-Authored-By: kontroll <kontroll@localhost>`
# (the identity the containers commit as); `none`/`off`/`disabled` = no trailer; any other text = that exact line.
# deploy-stack RE-RENDERS docker/.env on every deploy from the Ansible var `kontroll_commit_trailer` (a hand edit
# here is overwritten) — set it there. The operator CLI (galaxy.py --commit) runs outside the containers and reads
# the same variable from the calling shell: `export KONTROLL_COMMIT_TRAILER=…`.
KONTROLL_COMMIT_TRAILER=

# --- Storage locations (pre-provision your disks here) — FAIL-CLOSED, behaviour-preserving defaults ---
# Every at-rest BIND store derives from KONTROLL_STORAGE_ROOT (one disk for everything) unless you override a
# HIGH-growth class below to put it on a separate, roomier disk. Defaults preserve today's EXACT paths, so
# leaving these unset binds + chowns exactly where the stack does today. The deploy-stack chown FOLLOWS the path
# you set (the dir is created uid-scoped 0750/0700 BEFORE the stack comes up — never a Docker-made root:root 0755;
# the check-storage-chown validate gate enforces this, closing G9). A missing root itself is made root's 0711:
# passable, listed by nobody else. An empty value can never mean "/" because each
# compose source carries a concrete ${VAR:-/var/lib/kontroll/…} default + deploy-stack asserts a safe root.
# NOTE: named volumes (Prometheus TSDB, Grafana, Postgres, Vector buffers) are Docker-managed and NOT relocated
# here; api/onboard-gui/caddy config dirs derive from the root automatically (no per-dir knob). SECURITY.md C8.
KONTROLL_STORAGE_ROOT=/var/lib/kontroll
# High-growth overrides — point these at a data disk if your system disk is small (else they follow the root):
KONTROLL_LOGS_DIR=/var/lib/kontroll/loki                # Loki log store (chunks + TSDB index + compactor) — HIGH
KONTROLL_BACKUPS_DIR=/var/lib/kontroll/backups          # Semaphore config-capture history (secret-bearing, 0700)
KONTROLL_API_AUDIT_DIR=/var/lib/kontroll/api/audit      # API audit log (run_id-correlated; never creds)
KONTROLL_GUI_AUDIT_DIR=/var/lib/kontroll/onboard-gui/audit  # onboard-gui audit log (M11 — off the code/propose tree)
KONTROLL_ANSIBLE_LOG_DIR=/var/lib/kontroll/ansible-log  # Ansible run-log
# The local canonical bare git is DELIBERATELY outside the storage root (the operator must traverse it to push);
# relocatable on its own, but do NOT fold it under KONTROLL_STORAGE_ROOT.
KONTROLL_CANONICAL_GIT=/srv/kontroll.git

# --- DEVICE / CONSUMER secret env vars (the telemetry exporter creds below + the credentialed-pull logging tokens)
# are ALL rendered into the live .env by deploy-stack from the GENERATED unified manifest
# (config/secret-env.manifest.generated.yml) — every telemetry metrics: + logging logs: method's `secret_env_map`,
# composed via the kontroll_render_token filter (no_log) from its SOPS secret_domain. They are NOT hand-listed/
# rendered here; a new credentialed exporter/pull is a descriptor drop-in, zero deploy-stack edit. Leave any such
# var EMPTY here — the value is never committed. ---
# prometheus-pve-exporter (Proxmox metrics) — the EXISTING read-only *.Audit token (telemetry/pve.yml secret_env_map):
PVE_EXPORTER_USER=
PVE_EXPORTER_TOKEN_NAME=
PVE_EXPORTER_TOKEN_VALUE=
# credentialed-pull logging token (e.g. proxmox_api -> logging/proxmox_api.yml secret_env_map):
KONTROLL_PVE_LOG_TOKEN=

# --- API frontend exposure (rendered by deploy-stack from instance/instance.yml frontend.tls_mode
# via scripts/kontroll/frontend.py). self_signed default shown; byo_proxy => --forwarded-allow-ips=* ---
KONTROLL_API_UVICORN_EXTRA=--ssl-keyfile /tls/api.key --ssl-certfile /tls/api.crt

# --- Caddy HTTPS ingress (frontend.tls_mode=acme ONLY; see docs/frontend-exposure.md) ---
# KONTROLL_CADDY_IMAGE: an xcaddy build carrying your DNS provider's caddy-dns module (stock caddy:2 has none).
KONTROLL_CADDY_IMAGE=caddy:2.11.4
# DNS-01 provider API token — the REAL value lives SOPS-encrypted (instance/secrets/acme.sops.yml), rendered here.
KONTROLL_ACME_DNS_TOKEN=

# --- Homepage widget tokens: NOT in this file ---
# Homepage never reads the stack .env (it would hand every stack secret to an unauthenticated portal). Put
# `homepage_var_<name>: <token>` keys in the `dashboards` SOPS domain; deploy-stack renders them, upper-cased, into
# docker/.env.homepage (Homepage's own env_file), and a tile references one as {{HOMEPAGE_VAR_<NAME>}}.

# --- Onboarding GUI (privileged surface — fail-closed auth) ---
GUI_USER=admin
GUI_PASSWORD=changeme-gui          # real value from SOPS (dashboards: gui_admin_password)
# TLS cert+key are host-provisioned at /var/lib/kontroll/onboard-gui/tls (self-signed ok)
